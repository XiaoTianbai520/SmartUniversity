<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smart.university.mapper.SelectionBatchMapper">

    <sql id="Base_Column_List">
        id, batch_name, semester_id, start_time, end_time, drop_deadline, status, created_at, updated_at
    </sql>

    <select id="getSelectionBatchById" parameterType="java.lang.Long"
            resultType="com.smart.university.domain.entity.SelectionBatchDO">
        SELECT
        <include refid="Base_Column_List"/>
        FROM selection_batch
        WHERE id = #{value}
    </select>

    <select id="getCurrentSelectionBatch" parameterType="java.lang.Long"
            resultType="com.smart.university.domain.entity.SelectionBatchDO">
        SELECT
        <include refid="Base_Column_List"/>
        FROM selection_batch
        WHERE semester_id = #{value}
        AND status = 'IN_PROGRESS'
        AND start_time &lt;= NOW()
        AND end_time &gt;= NOW()
        ORDER BY start_time ASC
        LIMIT 1
    </select>

    <sql id="Condition_Where">
        <where>
            <if test="semesterId != null">AND semester_id = #{semesterId}</if>
            <if test="status != null and status != ''">AND status = #{status}</if>
        </where>
    </sql>

    <select id="countSelectionBatchByCondition"
            parameterType="com.smart.university.domain.dto.req.SelectionBatchPageQueryReqDTO" resultType="long">
        SELECT COUNT(*) FROM selection_batch
        <include refid="Condition_Where"/>
    </select>

    <select id="listSelectionBatchByCondition"
            parameterType="com.smart.university.domain.dto.req.SelectionBatchPageQueryReqDTO"
            resultType="com.smart.university.domain.entity.SelectionBatchDO">
        SELECT
        <include refid="Base_Column_List"/>
        FROM selection_batch
        <include refid="Condition_Where"/>
        ORDER BY start_time DESC
        LIMIT #{offset}, #{limit}
    </select>

    <insert id="saveSelectionBatch" parameterType="com.smart.university.domain.entity.SelectionBatchDO"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO selection_batch (batch_name, semester_id, start_time, end_time, drop_deadline, status)
        VALUES (#{batchName}, #{semesterId}, #{startTime}, #{endTime}, #{dropDeadline}, #{status})
    </insert>

    <update id="updateSelectionBatch" parameterType="com.smart.university.domain.entity.SelectionBatchDO">
        UPDATE selection_batch
        <set>
            <if test="batchName != null">batch_name = #{batchName},</if>
            <if test="semesterId != null">semester_id = #{semesterId},</if>
            <if test="startTime != null">start_time = #{startTime},</if>
            <if test="endTime != null">end_time = #{endTime},</if>
            <if test="dropDeadline != null">drop_deadline = #{dropDeadline},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE id = #{id}
    </update>
</mapper>
