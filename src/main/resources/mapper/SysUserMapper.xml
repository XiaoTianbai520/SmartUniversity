<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smart.university.mapper.SysUserMapper">

    <sql id="Base_Column_List">
        id, username, password_hash, role, status, last_login_at, created_at, updated_at
    </sql>

    <select id="getUserById" parameterType="java.lang.Long" resultType="com.smart.university.domain.entity.SysUserDO">
        SELECT
        <include refid="Base_Column_List"/>
        FROM sys_user
        WHERE id = #{value}
    </select>

    <select id="getUserByUsername" parameterType="java.lang.String" resultType="com.smart.university.domain.entity.SysUserDO">
        SELECT
        <include refid="Base_Column_List"/>
        FROM sys_user
        WHERE username = #{value}
        LIMIT 1
    </select>

    <select id="countUserByUsername" parameterType="java.lang.String" resultType="long">
        SELECT COUNT(*) FROM sys_user WHERE username = #{value}
    </select>

    <insert id="saveUser" parameterType="com.smart.university.domain.entity.SysUserDO"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_user (username, password_hash, role, status, last_login_at)
        VALUES (#{username}, #{passwordHash}, #{role}, #{status}, #{lastLoginAt})
    </insert>

    <update id="updateUser" parameterType="com.smart.university.domain.entity.SysUserDO">
        UPDATE sys_user
        <set>
            <if test="passwordHash != null">password_hash = #{passwordHash},</if>
            <if test="role != null">role = #{role},</if>
            <if test="status != null">status = #{status},</if>
            <if test="lastLoginAt != null">last_login_at = #{lastLoginAt},</if>
        </set>
        WHERE id = #{id}
    </update>
</mapper>
