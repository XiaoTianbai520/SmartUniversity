<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smart.university.mapper.StudentMapper">

    <sql id="Base_Column_List">
        id, user_id, student_no, student_name, major_id, grade_id, class_id, status, created_at, updated_at
    </sql>

    <select id="getStudentById" parameterType="java.lang.Long" resultType="com.smart.university.domain.entity.StudentDO">
        SELECT
        <include refid="Base_Column_List"/>
        FROM student
        WHERE id = #{value}
    </select>

    <select id="getStudentByUserId" parameterType="java.lang.Long" resultType="com.smart.university.domain.entity.StudentDO">
        SELECT
        <include refid="Base_Column_List"/>
        FROM student
        WHERE user_id = #{value}
        LIMIT 1
    </select>

    <select id="getStudentByStudentNo" parameterType="java.lang.String" resultType="com.smart.university.domain.entity.StudentDO">
        SELECT
        <include refid="Base_Column_List"/>
        FROM student
        WHERE student_no = #{value}
        LIMIT 1
    </select>

    <select id="listStudentByIds" resultType="com.smart.university.domain.entity.StudentDO">
        SELECT
        <include refid="Base_Column_List"/>
        FROM student
        WHERE id IN
        <foreach collection="collection" item="each" open="(" separator="," close=")">
            #{each}
        </foreach>
    </select>

    <select id="countStudentByStudentNo" parameterType="java.lang.String" resultType="long">
        SELECT COUNT(*) FROM student WHERE student_no = #{value}
    </select>

    <sql id="Condition_Where">
        <where>
            <if test="keyword != null and keyword != ''">
                AND (s.student_no LIKE CONCAT('%', #{keyword}, '%')
                OR s.student_name LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="majorId != null">AND s.major_id = #{majorId}</if>
            <if test="gradeId != null">AND s.grade_id = #{gradeId}</if>
            <if test="classId != null">AND s.class_id = #{classId}</if>
            <if test="status != null">AND s.status = #{status}</if>
        </where>
    </sql>

    <select id="countStudentByCondition"
            parameterType="com.smart.university.domain.dto.req.StudentPageQueryReqDTO" resultType="long">
        SELECT COUNT(*)
        FROM student s
        <include refid="Condition_Where"/>
    </select>

    <select id="listStudentByCondition"
            parameterType="com.smart.university.domain.dto.req.StudentPageQueryReqDTO"
            resultType="com.smart.university.domain.entity.StudentDO">
        SELECT s.id, s.user_id, s.student_no, s.student_name, s.major_id, s.grade_id, s.class_id, s.status,
        s.created_at, s.updated_at
        FROM student s
        <include refid="Condition_Where"/>
        ORDER BY s.id DESC
        LIMIT #{offset}, #{limit}
    </select>

    <insert id="saveStudent" parameterType="com.smart.university.domain.entity.StudentDO"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO student (user_id, student_no, student_name, major_id, grade_id, class_id, status)
        VALUES (#{userId}, #{studentNo}, #{studentName}, #{majorId}, #{gradeId}, #{classId}, #{status})
    </insert>

    <update id="updateStudent" parameterType="com.smart.university.domain.entity.StudentDO">
        UPDATE student
        <set>
            <if test="studentNo != null">student_no = #{studentNo},</if>
            <if test="studentName != null">student_name = #{studentName},</if>
            <if test="majorId != null">major_id = #{majorId},</if>
            <if test="gradeId != null">grade_id = #{gradeId},</if>
            <if test="classId != null">class_id = #{classId},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE id = #{id}
    </update>
</mapper>
