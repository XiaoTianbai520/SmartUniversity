<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smart.university.mapper.TeacherMapper">

    <sql id="Base_Column_List">
        id, user_id, teacher_no, teacher_name, title, status, created_at, updated_at
    </sql>

    <select id="getTeacherById" parameterType="java.lang.Long" resultType="com.smart.university.domain.entity.TeacherDO">
        SELECT
        <include refid="Base_Column_List"/>
        FROM teacher
        WHERE id = #{value}
    </select>

    <select id="getTeacherByUserId" parameterType="java.lang.Long" resultType="com.smart.university.domain.entity.TeacherDO">
        SELECT
        <include refid="Base_Column_List"/>
        FROM teacher
        WHERE user_id = #{value}
        LIMIT 1
    </select>

    <select id="getTeacherByTeacherNo" parameterType="java.lang.String" resultType="com.smart.university.domain.entity.TeacherDO">
        SELECT
        <include refid="Base_Column_List"/>
        FROM teacher
        WHERE teacher_no = #{value}
        LIMIT 1
    </select>

    <select id="listTeacherByIds" resultType="com.smart.university.domain.entity.TeacherDO">
        SELECT
        <include refid="Base_Column_List"/>
        FROM teacher
        WHERE id IN
        <foreach collection="collection" item="each" open="(" separator="," close=")">
            #{each}
        </foreach>
    </select>

    <select id="countTeacherByTeacherNo" parameterType="java.lang.String" resultType="long">
        SELECT COUNT(*) FROM teacher WHERE teacher_no = #{value}
    </select>

    <sql id="Condition_Where">
        <where>
            <if test="keyword != null and keyword != ''">
                AND (teacher_no LIKE CONCAT('%', #{keyword}, '%')
                OR teacher_name LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="status != null">AND status = #{status}</if>
        </where>
    </sql>

    <select id="countTeacherByCondition"
            parameterType="com.smart.university.domain.dto.req.TeacherPageQueryReqDTO" resultType="long">
        SELECT COUNT(*) FROM teacher
        <include refid="Condition_Where"/>
    </select>

    <select id="listTeacherByCondition"
            parameterType="com.smart.university.domain.dto.req.TeacherPageQueryReqDTO"
            resultType="com.smart.university.domain.entity.TeacherDO">
        SELECT
        <include refid="Base_Column_List"/>
        FROM teacher
        <include refid="Condition_Where"/>
        ORDER BY id DESC
        LIMIT #{offset}, #{limit}
    </select>

    <insert id="saveTeacher" parameterType="com.smart.university.domain.entity.TeacherDO"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO teacher (user_id, teacher_no, teacher_name, title, status)
        VALUES (#{userId}, #{teacherNo}, #{teacherName}, #{title}, #{status})
    </insert>

    <update id="updateTeacher" parameterType="com.smart.university.domain.entity.TeacherDO">
        UPDATE teacher
        <set>
            <if test="teacherNo != null">teacher_no = #{teacherNo},</if>
            <if test="teacherName != null">teacher_name = #{teacherName},</if>
            <if test="title != null">title = #{title},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE id = #{id}
    </update>
</mapper>
