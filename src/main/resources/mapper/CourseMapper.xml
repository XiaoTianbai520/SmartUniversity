<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smart.university.mapper.CourseMapper">

    <sql id="Base_Column_List">
        id, course_code, course_name, description, credit, course_type, default_capacity, status,
        created_at, updated_at
    </sql>

    <select id="getCourseById" parameterType="java.lang.Long" resultType="com.smart.university.domain.entity.CourseDO">
        SELECT
        <include refid="Base_Column_List"/>
        FROM course
        WHERE id = #{value}
    </select>

    <select id="listCourseByIds" resultType="com.smart.university.domain.entity.CourseDO">
        SELECT
        <include refid="Base_Column_List"/>
        FROM course
        WHERE id IN
        <foreach collection="collection" item="each" open="(" separator="," close=")">
            #{each}
        </foreach>
    </select>

    <select id="countCourseByCourseCode" parameterType="java.lang.String" resultType="long">
        SELECT COUNT(*) FROM course WHERE course_code = #{value}
    </select>

    <sql id="Condition_Where">
        <where>
            <if test="keyword != null and keyword != ''">
                AND (course_code LIKE CONCAT('%', #{keyword}, '%')
                OR course_name LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="courseType != null and courseType != ''">AND course_type = #{courseType}</if>
            <if test="status != null">AND status = #{status}</if>
        </where>
    </sql>

    <select id="countCourseByCondition"
            parameterType="com.smart.university.domain.dto.req.CoursePageQueryReqDTO" resultType="long">
        SELECT COUNT(*) FROM course
        <include refid="Condition_Where"/>
    </select>

    <select id="listCourseByCondition"
            parameterType="com.smart.university.domain.dto.req.CoursePageQueryReqDTO"
            resultType="com.smart.university.domain.entity.CourseDO">
        SELECT
        <include refid="Base_Column_List"/>
        FROM course
        <include refid="Condition_Where"/>
        ORDER BY id DESC
        LIMIT #{offset}, #{limit}
    </select>

    <insert id="saveCourse" parameterType="com.smart.university.domain.entity.CourseDO"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO course (course_code, course_name, description, credit, course_type, default_capacity, status)
        VALUES (#{courseCode}, #{courseName}, #{description}, #{credit}, #{courseType}, #{defaultCapacity}, #{status})
    </insert>

    <update id="updateCourse" parameterType="com.smart.university.domain.entity.CourseDO">
        UPDATE course
        <set>
            <if test="courseCode != null">course_code = #{courseCode},</if>
            <if test="courseName != null">course_name = #{courseName},</if>
            <if test="description != null">description = #{description},</if>
            <if test="credit != null">credit = #{credit},</if>
            <if test="courseType != null">course_type = #{courseType},</if>
            <if test="defaultCapacity != null">default_capacity = #{defaultCapacity},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE id = #{id}
    </update>
</mapper>
