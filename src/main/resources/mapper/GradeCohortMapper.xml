<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smart.university.mapper.GradeCohortMapper">

    <sql id="Base_Column_List">
        id, grade_name, entry_year, status, created_at, updated_at
    </sql>

    <select id="getGradeCohortById" parameterType="java.lang.Long" resultType="com.smart.university.domain.entity.GradeCohortDO">
        SELECT
        <include refid="Base_Column_List"/>
        FROM grade_cohort
        WHERE id = #{value}
    </select>

    <select id="listGradeCohortByIds" resultType="com.smart.university.domain.entity.GradeCohortDO">
        SELECT
        <include refid="Base_Column_List"/>
        FROM grade_cohort
        WHERE id IN
        <foreach collection="collection" item="each" open="(" separator="," close=")">
            #{each}
        </foreach>
    </select>

    <select id="countGradeCohortByCondition"
            parameterType="com.smart.university.domain.dto.req.GradePageQueryReqDTO" resultType="long">
        SELECT COUNT(*) FROM grade_cohort
        <where>
            <if test="keyword != null and keyword != ''">AND grade_name LIKE CONCAT('%', #{keyword}, '%')</if>
            <if test="status != null">AND status = #{status}</if>
        </where>
    </select>

    <select id="listGradeCohortByCondition"
            parameterType="com.smart.university.domain.dto.req.GradePageQueryReqDTO"
            resultType="com.smart.university.domain.entity.GradeCohortDO">
        SELECT
        <include refid="Base_Column_List"/>
        FROM grade_cohort
        <where>
            <if test="keyword != null and keyword != ''">AND grade_name LIKE CONCAT('%', #{keyword}, '%')</if>
            <if test="status != null">AND status = #{status}</if>
        </where>
        ORDER BY entry_year DESC
        LIMIT #{offset}, #{limit}
    </select>

    <insert id="saveGradeCohort" parameterType="com.smart.university.domain.entity.GradeCohortDO"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO grade_cohort (grade_name, entry_year, status)
        VALUES (#{gradeName}, #{entryYear}, #{status})
    </insert>

    <update id="updateGradeCohort" parameterType="com.smart.university.domain.entity.GradeCohortDO">
        UPDATE grade_cohort
        <set>
            <if test="gradeName != null">grade_name = #{gradeName},</if>
            <if test="entryYear != null">entry_year = #{entryYear},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE id = #{id}
    </update>
</mapper>
