<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smart.university.mapper.MajorMapper">

    <sql id="Base_Column_List">
        id, major_code, major_name, status, created_at, updated_at
    </sql>

    <select id="getMajorById" parameterType="java.lang.Long" resultType="com.smart.university.domain.entity.MajorDO">
        SELECT
        <include refid="Base_Column_List"/>
        FROM major
        WHERE id = #{value}
    </select>

    <select id="listMajorByIds" resultType="com.smart.university.domain.entity.MajorDO">
        SELECT
        <include refid="Base_Column_List"/>
        FROM major
        WHERE id IN
        <foreach collection="collection" item="each" open="(" separator="," close=")">
            #{each}
        </foreach>
    </select>

    <select id="countMajorByCondition"
            parameterType="com.smart.university.domain.dto.req.MajorPageQueryReqDTO" resultType="long">
        SELECT COUNT(*) FROM major
        <where>
            <if test="keyword != null and keyword != ''">
                AND (major_code LIKE CONCAT('%', #{keyword}, '%')
                OR major_name LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="status != null">AND status = #{status}</if>
        </where>
    </select>

    <select id="listMajorByCondition"
            parameterType="com.smart.university.domain.dto.req.MajorPageQueryReqDTO"
            resultType="com.smart.university.domain.entity.MajorDO">
        SELECT
        <include refid="Base_Column_List"/>
        FROM major
        <where>
            <if test="keyword != null and keyword != ''">
                AND (major_code LIKE CONCAT('%', #{keyword}, '%')
                OR major_name LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="status != null">AND status = #{status}</if>
        </where>
        ORDER BY id DESC
        LIMIT #{offset}, #{limit}
    </select>

    <insert id="saveMajor" parameterType="com.smart.university.domain.entity.MajorDO"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO major (major_code, major_name, status)
        VALUES (#{majorCode}, #{majorName}, #{status})
    </insert>

    <update id="updateMajor" parameterType="com.smart.university.domain.entity.MajorDO">
        UPDATE major
        <set>
            <if test="majorCode != null">major_code = #{majorCode},</if>
            <if test="majorName != null">major_name = #{majorName},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE id = #{id}
    </update>
</mapper>
